# DexCompare (sealed) — copy to .env for local development.

# Postgres. In Vercel: the Neon POOLED connection string (host contains "-pooler").
# In the GitHub Actions secret DEXCOMPARE_SEALED_DATABASE_URL: the DIRECT string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dexsealed"

# Canonical site origin, no trailing slash. Used in canonical URLs, the sitemap
# and email links.
NEXT_PUBLIC_SITE_URL="https://dexcompare.app"

# Shared secret between the import job and /api/revalidate. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=""

# Optional.
NEXT_PUBLIC_CONTACT_EMAIL="riftcompare@gmail.com"
NEXT_PUBLIC_EBAY_CAMPAIGN_ID="5339155912"
NEXT_PUBLIC_TCGPLAYER_IMPACT_LINK="https://partner.tcgplayer.com/c/7385758/1780961/21018"
# Optional official EPN banner (EPN Campaign Manager > Tools > Banners), shown instead of
# the native eBay banner on the region home hero and above the footer. Both must be valid
# https values (the link on an eBay domain with our campid, the image on eBay's hosts), or the native banners stay. See DEPLOY.md.
NEXT_PUBLIC_EBAY_BANNER_IMAGE=""
NEXT_PUBLIC_EBAY_BANNER_HREF=""
NEXT_PUBLIC_EBAY_BANNER_WIDTH="728"
NEXT_PUBLIC_EBAY_BANNER_HEIGHT="90"
NEXT_PUBLIC_EBAY_BANNER_ALT=""
GOOGLE_SITE_VERIFICATION=""
