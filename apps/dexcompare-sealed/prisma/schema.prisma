// DexCompare (sealed) — Pokémon TCG sealed products compared across stores.
//
// DELIBERATELY NO HISTORY. Every table holds the CURRENT state only: the latest
// read of each store's listings, the per-market summary derived from them, and
// who asked to be told about a restock. There is no price-history, no
// restock-event log and no first-seen table. That keeps the database small and
// flat (a few thousand rows, not millions), which is what keeps it inside
// Neon's free tier. See README.md, "What this site does not store".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One sealed product, e.g. "Surging Sparks Elite Trainer Box". Market-agnostic:
// the same product exists in every region, and each region's offers hang off it.
// Rows are kept when every store sells out, so a product's URL keeps working
// (and its restock alerts keep their target) between restocks.
model Product {
  id          String   @id @default(cuid())
  // Identity from the title classifier (src/lib/sealed-title.ts): "<set>|<type>"
  // for set products, "<type>|<set or ->|<signature>" for collections, tins, etc.
  groupKey    String   @unique
  slug        String   @unique
  name        String
  productType String
  setCode     String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  offers Offer[]
  stats  ProductStat[]
  alerts RestockAlert[]

  @@index([setCode])
  @@index([productType])
}

// A store's current listing for a product. One row per (product, store): the
// importer keeps the best listing a store has (in stock first, then cheapest).
// A store's rows are replaced only after a SUCCESSFUL read of that store, so a
// failed read keeps yesterday's rows, which then age into "unknown" (see
// src/lib/sealed-offers.ts) rather than vanishing.
model Offer {
  id         String   @id @default(cuid())
  productId  String
  store      String // store key, see src/lib/stores/
  market     String // AU | NZ | US | UK | CA | EU | SG — also the currency
  title      String // the store's own product title
  url        String
  priceCents Int
  inStock    Boolean
  imageUrl   String?
  lastSeen   DateTime // the importer's last successful read of this store

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, store])
  @@index([store])
  @@index([market, productId])
}

// Per-market summary of a product, recomputed wholesale by every import. This
// is what listing pages read, so a region's browse page is one indexed read
// instead of an aggregate over every offer on every request.
model ProductStat {
  productId        String
  market           String
  lowestPriceCents Int? // cheapest OPEN offer (in stock and freshly read); null = none
  inStockStores    Int
  listedStores     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, market])
  @@index([market, inStockStores])
}

// Per-store health from the latest import: how many sealed listings the store
// had and whether the last read worked. Current state only.
model StoreStat {
  store      String    @id
  market     String
  listed     Int       @default(0)
  inStock    Int       @default(0)
  lastOkAt   DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt

  @@index([market])
}

// "Email me when this is back in stock" — no account needed. notifiedAt is set
// when we email for the CURRENT in-stock window and cleared once the product is
// sold out everywhere in that market again, so the subscriber hears about the
// next restock too. State, not a log.
model RestockAlert {
  id         String    @id @default(cuid())
  email      String // lowercased + trimmed
  productId  String
  market     String
  // Per-email secret shared by all of an address's alerts: one unsubscribe link
  // removes everything for that address.
  token      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId, market])
  @@index([productId, market])
  @@index([token])
}
