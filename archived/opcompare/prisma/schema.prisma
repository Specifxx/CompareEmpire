// DexCompare — Pokémon TCG price-comparison database schema.
// Enums are represented as Strings because the original SQLite MVP connector did
// not support native enums; allowed values are validated in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String    @id @default(cuid())
  externalId      String?   @unique // RiftScribe id, e.g. "ogn-001-298"
  slug            String?   @unique // human-readable URL, e.g. "vayne-hunter-sfd-223s-221"
  name            String
  // Lowercased, punctuation-stripped name for apostrophe-tolerant search.
  nameNormalized  String  @default("")
  // Base character grouping for the /character/{slug} hubs — e.g. every
  // "Monkey D. Luffy" printing (Leader, Character, alt-arts, all sets) shares
  // characterSlug "monkey-d-luffy". Computed by lib/op-characters.ts at import
  // time. Fixed-width columns on the existing row: no storage growth.
  characterSlug   String?
  characterName   String?
  setCode         String // e.g. "OGN"
  setName         String // e.g. "Origins"
  collectorNumber String // e.g. "001/298"
  // One of the Riftbound domains: Fury, Calm, Mind, Body, Chaos, Order, Colorless
  domain          String
  // Unit, Spell, Gear, Rune, Battlefield, Legend
  type            String
  // Common, Uncommon, Rare, Epic, Showcase
  rarity          String
  // Alt-art / variant suffix from the card number, e.g. "a" for 112a. null = base art.
  variant         String?
  // Promo printing (prerelease / organized-play). Shares the base card's art.
  isPromo         Boolean @default(false)
  orientation     String? // portrait | landscape
  energyCost      Int?
  might           Int?
  power           Int?
  tags            String? // comma-separated keyword tags
  description     String?
  flavorText      String?
  // Real card images (RiftScribe CDN). Falls back to generated SVG art if null.
  imageUrl        String? // full-resolution
  imageThumbUrl   String? // smaller webp for grids
  blurDataUrl     String? // tiny base64 placeholder
  // Market-price GUIDE in USD cents — a sales-based reference (TCGplayer market
  // price via pokemontcg.io at seed time, refreshed from TCGplayer's live feed by
  // the importer). Shown clearly labelled with its source; NEVER used as the
  // "cheapest"/"from" price (that always comes from a real, buyable store listing).
  marketPriceCents Int      @default(0)
  // Where the market guide came from ("TCGplayer" | "Estimate"), and when it was
  // last refreshed — surfaced next to the guide so the source is always visible.
  marketPriceSource    String?
  marketPriceUpdatedAt DateTime?
  // Lowest live retailer price across all sources, set by the price importer.
  // Used for "from $X" and catalogue sorting. null = no price found.
  //   lowestPriceCents   = Australia (AUD cents), from AU stores + eBay AU
  //   lowestPriceCentsNz = New Zealand (NZD cents), from NZ stores (no eBay)
  //   lowestPriceCentsUs = United States (USD cents), from US stores + eBay US
  //   lowestPriceCentsGb = United Kingdom (GBP cents), from UK TCG stores + eBay UK
  lowestPriceCents Int?
  lowestPriceCentsNz Int?
  lowestPriceCentsUs Int?
  lowestPriceCentsGb Int?
  // Denormalised OR of the lowestPriceCents* columns, set by the importer.
  // One indexed boolean instead of a 4-column OR scan on every catalogue read,
  // and the single source of truth for sitemap/browse indexability.
  hasLivePrice    Boolean   @default(false)
  artSeed         Int       @default(0)
  // Popularity signals. searchCount (clicks from the search box) is the purer demand
  // metric and drives eBay prioritisation; viewCount (any open, incl. featured
  // homepage clicks) is kept for general "trending" use.
  viewCount       Int       @default(0)
  searchCount     Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  retailerPrices  RetailerPrice[]
  priceAlerts     PriceAlert[]
  reviews         CardReview[]
  deals           Deal[]

  @@index([setCode, collectorNumber])
  @@index([nameNormalized])
  @@index([characterSlug])
  @@index([hasLivePrice])
  @@index([lowestPriceCents])
  @@index([lowestPriceCentsNz])
  @@index([lowestPriceCentsUs])
  @@index([lowestPriceCentsGb])
  @@index([domain])
  @@index([rarity])
  @@index([type])
}

// Feedback / contact-form submissions. Saved here as a backup and forwarded by
// email to the site owner.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A wishlist price-drop subscription. No account needed — keyed by email, created
// from the wishlist pop-up. The daily cron (/api/cron/price-alerts) compares each
// card's current lowest price in the subscriber's market against lastPriceCents
// and emails a digest of genuine drops.
model PriceAlert {
  id             String    @id @default(cuid())
  email          String // lowercased + trimmed on write
  cardId         String
  market         String    @default("AU") // AU | NZ | US | GB
  // Baseline for drop detection — advanced to the current price on every run
  // (up or down) so a later dip is measured against the most recent price.
  lastPriceCents Int?
  // Per-email secret shared by all of that email's alerts, so one link in the
  // email footer unsubscribes everything for the address.
  unsubToken     String
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?

  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([email, cardId, market])
  @@index([email])
  @@index([unsubToken])
  @@index([cardId])
}

// A "tell me when it restocks" subscription for a featured sealed product (see
// src/lib/restocks.ts). No account needed — keyed by email + product + market.
// The restock cron emails subscribers when the product flips to in-stock in their
// market, then re-arms (notifiedAt back to null) once it sells out again.
model RestockAlert {
  id          String    @id @default(cuid())
  email       String // lowercased + trimmed on write
  productSlug String // FeaturedRestock.slug, e.g. "chaos-rising"
  market      String    @default("AU") // AU | NZ | US | GB
  // Per-email secret shared across this email's alerts → one-click unsubscribe.
  unsubToken  String
  createdAt   DateTime  @default(now())
  // Set when we've emailed this subscriber about the CURRENT in-stock window;
  // cleared when the product goes out of stock again so they get the next restock.
  notifiedAt  DateTime?

  @@unique([email, productSlug, market])
  @@index([productSlug, market])
  @@index([unsubToken])
  @@index([email])
}

// A historical restock event for a featured product — recorded when a store's
// listing transitions out-of-stock → in-stock, and closed (soldOutAt + duration)
// when it sells out again. Powers the "restock log" on the tracker page (proof
// the tracker works + how fast stock vanishes) and is screenshot-bait for Reddit.
model RestockEvent {
  id           String    @id @default(cuid())
  productSlug  String
  market       String    @default("AU")
  retailer     String
  retailerName String
  productType  String // "Booster Box", "Elite Trainer Box", …
  priceCents   Int
  url          String
  inStockAt    DateTime  @default(now())
  soldOutAt    DateTime?
  // Minutes the stock lasted before selling out (set when soldOutAt is recorded).
  durationMins Int?

  @@index([productSlug, market, inStockAt])
}

// A live price for a card at an external retailer, used for price comparison.
// Populated by scripts/import-prices.ts from AU store feeds (Shopify products.json).
model RetailerPrice {
  id           String   @id @default(cuid())
  cardId       String
  retailer     String // store key, e.g. "cherry", "ozzie"
  retailerName String // display name, e.g. "Cherry Collectables"
  title        String // original product title at the retailer
  url          String // outbound product link (affiliate-ready)
  condition    String? // headline grade of this row, e.g. "NM"
  // Compact cheapest-in-stock price per grade for this store+card, e.g.
  // {"NM":4500,"LP":3800,"MP":3200}. Lets the card page show the whole condition
  // spectrum from ONE row per store (rather than a row per grade, which blew past
  // the DB size limit). null = store didn't break out conditions.
  conditionPrices Json?
  isFoil       Boolean  @default(false)
  priceCents   Int
  // Actual shipping for this listing where the source provides it (e.g. eBay).
  // null = use the per-store flat estimate instead.
  shippingCents Int?
  currency     String   @default("AUD")
  inStock      Boolean  @default(true)
  lastSeen     DateTime @default(now())

  // Market: "AU" (Australian stores + eBay AU, AUD) or "NZ" (NZ stores, NZD).
  country      String   @default("AU")

  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // eBay uses a per-market retailer key ("ebay" = AU, "ebay_us" = US) so the same
  // card can have a listing in each marketplace without colliding on this key.
  @@unique([cardId, retailer, condition, isFoil])
  @@index([cardId])
  @@index([retailer])
  @@index([priceCents])
  @@index([cardId, country, inStock])
}

// Sealed / non-single Riftbound products (booster boxes, packs, Proving Grounds,
// bundles, …). One row per store listing; the /sealed page groups by groupKey to
// show the cheapest price per product across stores.
model SealedListing {
  id           String   @id @default(cuid())
  groupKey     String // normalised product identity for cross-store grouping
  title        String
  productType  String // "Booster Box", "Booster Pack", "Bundle", "Proving Grounds", …
  setCode      String? // OGN/SFD/UNL/OGS/VEN if detectable
  retailer     String
  retailerName String
  priceCents   Int
  url          String
  imageUrl     String?
  inStock      Boolean  @default(true)
  // Market: "AU" (Australian stores, AUD) or "NZ" (NZ stores, NZD).
  country      String   @default("AU")
  lastSeen     DateTime @default(now())

  @@index([groupKey])
  @@index([retailer])
  @@index([country])
}

// Footer newsletter capture — "weekly Index summary in your inbox". The weekly
// send itself is a workflow; this table is the direct-audience list.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  market    String   @default("AU")
  createdAt DateTime @default(now())
}

// Precomputed "today's best deals" rows, rebuilt by the importer after every
// price run. Reading deals is then one indexed, ordered scan instead of a
// full-catalogue comparison on every page view. Bounded: one row per rank per
// market, overwritten in place — it never grows with time.
model Deal {
  id         String   @id @default(cuid())
  cardId     String
  country    String // AU | NZ | US | GB
  rank       Int // 0-based, deepest discount first
  pct        Int // % below the market guide
  priceCents Int // cheapest live local price
  guideCents Int // TCGplayer guide converted to the local currency
  updatedAt  DateTime @default(now())

  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([country, rank])
  @@index([cardId])
}

// Genuine, user-submitted card ratings. No account needed (OPCompare has no
// accounts) — matches the restock-alert pattern. These are the ONLY source of
// the card page's aggregateRating/review structured data; we never fabricate
// ratings, so the markup appears only once a real review exists. ipHash (never
// a raw IP) caps self-rating abuse.
model CardReview {
  id        String   @id @default(cuid())
  cardId    String
  rating    Int // 1-5 stars
  title     String?
  body      String?
  author    String? // free-text display name; falls back to "Anonymous"
  status    String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  ipHash    String?
  createdAt DateTime @default(now())

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, status, createdAt])
}
