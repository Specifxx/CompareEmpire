# DexCompare (sealed) — copy to .env for local development.

# Postgres. In Vercel: the Neon POOLED connection string (host contains "-pooler").
# In the GitHub Actions secret DEXCOMPARE_SEALED_DATABASE_URL: the DIRECT string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dexsealed"

# Canonical site origin, no trailing slash. Used in canonical URLs, the sitemap
# and email links.
NEXT_PUBLIC_SITE_URL="https://dexcompare.com"

# Shared secret between the import job and /api/revalidate. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=""

# Restock alert emails (resend.com). Without a key, alerts are stored but not sent.
RESEND_API_KEY=""
EMAIL_FROM="DexCompare <alerts@dexcompare.com>"

# Optional.
NEXT_PUBLIC_CONTACT_EMAIL="hello@dexcompare.com"
NEXT_PUBLIC_EBAY_CAMPAIGN_ID="5339155912"
GOOGLE_SITE_VERIFICATION=""
