{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "reports": false
    }
  },
  "framework": "nextjs",
  "ignoreCommand": "exit 0",
  "crons": [
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 18 * * *"
    }
  ]
}
