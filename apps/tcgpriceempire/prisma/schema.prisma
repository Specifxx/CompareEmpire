// TCGPriceEmpire — unified multi-TCG price database.
//
// One schema covers all five games (Pokémon, Magic: The Gathering, Yu-Gi-Oh!,
// One Piece Card Game, Riftbound): every product row carries a `game`
// discriminator, and "sealed vs single" is a `kind` on the same table so search,
// browse and sitemaps stay one code path. Vendor prices hang off each card as
// rows (TCGplayer, Cardmarket, eBay, Amazon, CoolStuffInc, …) so the compare
// table is data-driven — adding a vendor is an import change, not a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A product: a single card or a sealed product, in one game's catalogue.
model Card {
  id                String   @id // "<game>:<source>:<sourceId>", e.g. "magic:scry:f3b0..." / "pokemon:tcg:478123"
  game              String // pokemon | magic | yugioh | onepiece | riftbound
  kind              String   @default("single") // single | sealed
  name              String
  slug              String   @unique // URL identity for /card/<slug>
  setName           String
  setCode           String?
  collectorNumber   String?
  rarity            String?
  imageUrl          String?
  // Headline market price in USD cents (TCGplayer market / Scryfall usd / YGOPRODeck
  // tcgplayer price) + where it came from, so the UI can always attribute it.
  marketPriceCents  Int?
  marketPriceSource String?
  releaseDate       String? // ISO date when the source provides one
  searchText        String   @default("") // normalized name+set for search
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  vendorPrices VendorPrice[]
  priceHistory PriceHistory[]

  @@index([game, kind])
  @@index([game, marketPriceCents(sort: Desc)])
  @@index([game, setName])
  @@index([name])
}

// One vendor's price for a card (one row per vendor × printing). Currency is the
// vendor's own (TCGplayer/eBay/Amazon/CoolStuffInc = USD, Cardmarket = EUR) —
// prices are shown in their native currency, never silently converted.
model VendorPrice {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  vendor     String // tcgplayer | cardmarket | ebay | amazon | coolstuffinc | cardhoarder
  vendorName String
  printing   String   @default("normal") // normal | foil | firstEdition | …
  priceCents Int
  currency   String // USD | EUR
  url        String
  updatedAt  DateTime @default(now())

  @@unique([cardId, vendor, printing])
  @@index([cardId])
}

// Daily snapshot of the headline market price — powers trend charts and movers.
model PriceHistory {
  id               String   @id @default(cuid())
  cardId           String
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  day              DateTime @db.Date
  marketPriceCents Int

  @@unique([cardId, day])
  @@index([cardId, day])
}

// Outbound-click beacon (which vendors/games actually earn) — mirrors the
// dexcompare/riftcompare click analytics so EPN/Impact earnings can be verified.
model ClickEvent {
  id        String   @id @default(cuid())
  retailer  String
  game      String   @default("")
  kind      String   @default("single")
  createdAt DateTime @default(now())

  @@index([retailer, createdAt])
}
