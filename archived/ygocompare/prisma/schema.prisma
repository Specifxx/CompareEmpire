// DexCompare — Pokémon TCG price-comparison database schema.
// Enums are represented as Strings because the original SQLite MVP connector did
// not support native enums; allowed values are validated in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Optional — accounts created via Google/Discord sign-in have no password.
  passwordHash String?
  displayName  String
  avatarUrl    String?
  // Set when the email is confirmed (instantly for OAuth, which is pre-verified).
  emailVerified DateTime?
  // OAuth identities (one per provider). Lets a user link Google and/or Discord.
  // Indexed (not DB-unique) so the push stays additive; uniqueness is enforced in
  // the OAuth callback (we find-or-create by provider id, then by email).
  googleId     String?
  discordId    String?
  // Wallet balance in AUD cents (e.g. 25000 = $250.00).
  // Funds committed to open buy orders are moved out of balance and held as
  // escrow on the BuyOrder (reservedCents) until the order fills or is cancelled.
  balanceCents Int       @default(0)
  isAdmin      Boolean   @default(false)
  // Marketplace: only verified sellers may create listings. Their listings surface
  // in the price comparison as the "CompareEmpire Marketplace" source.
  verifiedSeller Boolean @default(false)
  sellerName   String?   // public storefront name shown on the marketplace
  // Default shipping a seller charges per order (AUD/major-unit cents) and the order
  // total at/above which they ship free. Overridable per listing (Listing.shipCents).
  shipFlatCents    Int?
  shipFreeOverCents Int?
  createdAt    DateTime  @default(now())

  listings     Listing[]
  buyOrders    BuyOrder[]
  purchases    Order[]   @relation("BuyerOrders")
  sales        Order[]   @relation("SellerOrders")
  wishlist     WishlistItem[]
  authTokens   AuthToken[]

  @@index([googleId])
  @@index([discordId])
}

// One-time tokens for email verification and password reset (purpose-tagged).
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  purpose   String   // "verify" | "reset"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Per-account wishlist (server-side). The cookie wishlist is merged in on sign-in.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model Card {
  id              String    @id @default(cuid())
  externalId      String?   @unique // RiftScribe id, e.g. "ogn-001-298"
  slug            String?   @unique // human-readable URL, e.g. "vayne-hunter-sfd-223s-221"
  name            String
  // Lowercased, punctuation-stripped name for apostrophe-tolerant search.
  nameNormalized  String  @default("")
  setCode         String // e.g. "OGN"
  setName         String // e.g. "Origins"
  collectorNumber String // e.g. "001/298"
  // One of the Riftbound domains: Fury, Calm, Mind, Body, Chaos, Order, Colorless
  domain          String
  // Unit, Spell, Gear, Rune, Battlefield, Legend
  type            String
  // Common, Uncommon, Rare, Epic, Showcase
  rarity          String
  // Alt-art / variant suffix from the card number, e.g. "a" for 112a. null = base art.
  variant         String?
  // Promo printing (prerelease / organized-play). Shares the base card's art.
  isPromo         Boolean @default(false)
  orientation     String? // portrait | landscape
  energyCost      Int?
  might           Int?
  power           Int?
  tags            String? // comma-separated keyword tags
  description     String?
  flavorText      String?
  // Real card images (RiftScribe CDN). Falls back to generated SVG art if null.
  imageUrl        String? // full-resolution
  imageThumbUrl   String? // smaller webp for grids
  blurDataUrl     String? // tiny base64 placeholder
  // Market-price GUIDE in USD cents — a sales-based reference (TCGplayer market
  // price via pokemontcg.io at seed time, refreshed from TCGplayer's live feed by
  // the importer). Shown clearly labelled with its source; NEVER used as the
  // "cheapest"/"from" price (that always comes from a real, buyable store listing).
  marketPriceCents Int      @default(0)
  // Where the market guide came from ("TCGplayer" | "Estimate"), and when it was
  // last refreshed — surfaced next to the guide so the source is always visible.
  marketPriceSource    String?
  marketPriceUpdatedAt DateTime?
  // Lowest live retailer price across all sources, set by the price importer.
  // Used for "from $X" and catalogue sorting. null = no price found.
  //   lowestPriceCents   = Australia (AUD cents), from AU stores + eBay AU
  //   lowestPriceCentsNz = New Zealand (NZD cents), from NZ stores (no eBay)
  //   lowestPriceCentsUs = United States (USD cents), from US stores + eBay US
  //   lowestPriceCentsGb = United Kingdom (GBP cents), from UK TCG stores + eBay UK
  lowestPriceCents Int?
  lowestPriceCentsNz Int?
  lowestPriceCentsUs Int?
  lowestPriceCentsGb Int?
  artSeed         Int       @default(0)
  // Popularity signals. searchCount (clicks from the search box) is the purer demand
  // metric and drives eBay prioritisation; viewCount (any open, incl. featured
  // homepage clicks) is kept for general "trending" use.
  viewCount       Int       @default(0)
  searchCount     Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  listings        Listing[]
  buyOrders       BuyOrder[]
  retailerPrices  RetailerPrice[]
  priceHistory    PriceHistory[]
  priceAlerts     PriceAlert[]

  @@index([setCode, collectorNumber])
  @@index([nameNormalized])
  @@index([lowestPriceCents])
  @@index([lowestPriceCentsNz])
  @@index([lowestPriceCentsUs])
  @@index([lowestPriceCentsGb])
  @@index([domain])
  @@index([rarity])
  @@index([type])
}

// A seller's offer to sell (the "ask" side of the book).
model Listing {
  id          String   @id @default(cuid())
  cardId      String
  sellerId    String
  condition   String // NM, LP, MP, HP, DMG
  isFoil      Boolean  @default(false)
  priceCents  Int
  quantity    Int      @default(1)
  status      String   @default("ACTIVE") // ACTIVE, SOLD, CANCELLED
  // Market + currency the listing is priced in ("AU"/AUD, "NZ"/NZD, "US"/USD, "GB"/GBP)
  // so marketplace listings slot into the right region's price comparison.
  country     String   @default("AU")
  currency    String   @default("AUD")
  // Per-listing shipping override (major-unit cents); null = use the seller default.
  shipCents   Int?
  createdAt   DateTime @default(now())

  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([cardId])
  @@index([sellerId])
  @@index([status])
  @@index([priceCents])
}

// A buyer's standing request to buy (the "bid" side of the book). Lets demand
// exist even when there is zero stock — any seller can fill it.
model BuyOrder {
  id             String   @id @default(cuid())
  cardId         String
  buyerId        String
  condition      String // desired condition: NM, LP, MP, HP, DMG, or ANY
  isFoil         Boolean  @default(false)
  maxPriceCents  Int // bid price the buyer will pay per copy
  quantity       Int      @default(1)
  quantityFilled Int      @default(0)
  reservedCents  Int      @default(0) // escrowed funds still held for unfilled copies
  status         String   @default("OPEN") // OPEN, FILLED, CANCELLED
  createdAt      DateTime @default(now())

  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fills          Order[]

  @@index([cardId])
  @@index([buyerId])
  @@index([status])
  @@index([maxPriceCents])
}

// Legacy table from the retired password-reset feature. The feature (pages, API
// routes, UI) was removed, but the table is kept so its data isn't dropped; nothing
// in the app references this model anymore.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Feedback / contact-form submissions. Saved here as a backup and forwarded by
// email to the site owner.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Daily snapshot of a card's lowest live price, for the price-over-time chart
// (CSFloat-style). Written by the importer: at most one row per card per
// Australia/Sydney day — a same-day re-run (e.g. a deploy) replaces that day's
// value. Collected in the backend now; the chart ships once a week+ exists.
model PriceHistory {
  id               String   @id @default(cuid())
  cardId           String
  // Market this point is for (AU/NZ/US/GB); each market is priced in its own
  // currency. Defaults to "AU" so all pre-existing rows stay valid on migration.
  country          String   @default("AU")
  // Calendar day in Australia/Sydney (stored date-only), the chart's x-axis.
  day              DateTime @db.Date
  lowestPriceCents Int
  recordedAt       DateTime @default(now())

  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, country, day])
  @@index([cardId, country, day])
  // Serves the Price Watch movers query (all cards in one market over a window).
  @@index([country, day])
}

// A wishlist price-drop subscription. No account needed — keyed by email, created
// from the wishlist pop-up. The daily cron (/api/cron/price-alerts) compares each
// card's current lowest price in the subscriber's market against lastPriceCents
// and emails a digest of genuine drops.
model PriceAlert {
  id             String    @id @default(cuid())
  email          String // lowercased + trimmed on write
  cardId         String
  market         String    @default("AU") // AU | NZ | US | GB
  // Baseline for drop detection — advanced to the current price on every run
  // (up or down) so a later dip is measured against the most recent price.
  lastPriceCents Int?
  // Per-email secret shared by all of that email's alerts, so one link in the
  // email footer unsubscribes everything for the address.
  unsubToken     String
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?

  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([email, cardId, market])
  @@index([email])
  @@index([unsubToken])
  @@index([cardId])
}

// A "tell me when it restocks" subscription for a featured sealed product (see
// src/lib/restocks.ts). No account needed — keyed by email + product + market.
// The restock cron emails subscribers when the product flips to in-stock in their
// market, then re-arms (notifiedAt back to null) once it sells out again.
model RestockAlert {
  id          String    @id @default(cuid())
  email       String // lowercased + trimmed on write
  productSlug String // FeaturedRestock.slug, e.g. "chaos-rising"
  market      String    @default("AU") // AU | NZ | US | GB
  // Per-email secret shared across this email's alerts → one-click unsubscribe.
  unsubToken  String
  createdAt   DateTime  @default(now())
  // Set when we've emailed this subscriber about the CURRENT in-stock window;
  // cleared when the product goes out of stock again so they get the next restock.
  notifiedAt  DateTime?

  @@unique([email, productSlug, market])
  @@index([productSlug, market])
  @@index([unsubToken])
  @@index([email])
}

// A historical restock event for a featured product — recorded when a store's
// listing transitions out-of-stock → in-stock, and closed (soldOutAt + duration)
// when it sells out again. Powers the "restock log" on the tracker page (proof
// the tracker works + how fast stock vanishes) and is screenshot-bait for Reddit.
model RestockEvent {
  id           String    @id @default(cuid())
  productSlug  String
  market       String    @default("AU")
  retailer     String
  retailerName String
  productType  String // "Booster Box", "Elite Trainer Box", …
  priceCents   Int
  url          String
  inStockAt    DateTime  @default(now())
  soldOutAt    DateTime?
  // Minutes the stock lasted before selling out (set when soldOutAt is recorded).
  durationMins Int?

  @@index([productSlug, market, inStockAt])
}

// One outbound affiliate-link click (store / eBay / TCGplayer), recorded by the
// /api/click beacon. Lets us verify in our own DB that outbound links are used —
// e.g. cross-checking eBay Partner Network earnings — without trusting only the
// partner's dashboard. No user identifiers are stored.
model ClickEvent {
  id        String   @id @default(cuid())
  retailer  String // store key, e.g. "cherry", "ebay", "tcgplayer"
  country   String   @default("AU") // market the click came from
  kind      String   @default("single") // "single" | "sealed"
  createdAt DateTime @default(now())

  @@index([retailer, createdAt])
  @@index([createdAt])
}

// A community marketplace post: a user's "want to buy" (WTB) or "want to sell"
// (WTS) listing for Riftbound cards. Reddit-style board at /forum.
model ForumPost {
  id          String   @id @default(cuid())
  kind        String   // "WTB" | "WTS" | "DISCUSSION"
  title       String
  cardName    String?
  setCode     String?
  condition   String?  // NM, LP, MP, HP, DMG, or "Any"
  priceCents  Int?     // seller's asking price for the whole listing (optional)
  // Multi-card listings: [{ name, setCode?, condition?, qty, marketCents? }].
  items       Json?
  // Sum of the items' current market value — the "recommended" total price.
  marketCents Int?
  body        String
  contact     String   @default("") // how to reach the poster (email/Discord); blank for discussions
  // Seller/buyer location for postage estimates (WTB/WTS only).
  country     String?
  state       String?
  // Market the post belongs to ("AU" | "NZ" | "US"), from the poster's selected
  // country. Players only see posts for their own market.
  market      String   @default("AU")
  authorName  String
  userId      String?  // set if posted while logged in
  score       Int      @default(0)
  status      String   @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime @default(now())

  comments    ForumComment[]

  @@index([kind])
  @@index([createdAt])
  @@index([status])
  @@index([market])
}

// A comment on a forum post (Reddit-style discussion).
model ForumComment {
  id         String   @id @default(cuid())
  postId     String
  userId     String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// A live price for a card at an external retailer, used for price comparison.
// Populated by scripts/import-prices.ts from AU store feeds (Shopify products.json).
model RetailerPrice {
  id           String   @id @default(cuid())
  cardId       String
  retailer     String // store key, e.g. "cherry", "ozzie"
  retailerName String // display name, e.g. "Cherry Collectables"
  title        String // original product title at the retailer
  url          String // outbound product link (affiliate-ready)
  condition    String? // headline grade of this row, e.g. "NM"
  // Compact cheapest-in-stock price per grade for this store+card, e.g.
  // {"NM":4500,"LP":3800,"MP":3200}. Lets the card page show the whole condition
  // spectrum from ONE row per store (rather than a row per grade, which blew past
  // the DB size limit). null = store didn't break out conditions.
  conditionPrices Json?
  isFoil       Boolean  @default(false)
  priceCents   Int
  // Actual shipping for this listing where the source provides it (e.g. eBay).
  // null = use the per-store flat estimate instead.
  shippingCents Int?
  currency     String   @default("AUD")
  inStock      Boolean  @default(true)
  lastSeen     DateTime @default(now())

  // Market: "AU" (Australian stores + eBay AU, AUD) or "NZ" (NZ stores, NZD).
  country      String   @default("AU")

  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // eBay uses a per-market retailer key ("ebay" = AU, "ebay_us" = US) so the same
  // card can have a listing in each marketplace without colliding on this key.
  @@unique([cardId, retailer, condition, isFoil])
  @@index([cardId])
  @@index([retailer])
  @@index([priceCents])
  @@index([cardId, country, inStock])
}

// Sealed / non-single Riftbound products (booster boxes, packs, Proving Grounds,
// bundles, …). One row per store listing; the /sealed page groups by groupKey to
// show the cheapest price per product across stores.
model SealedListing {
  id           String   @id @default(cuid())
  groupKey     String // normalised product identity for cross-store grouping
  title        String
  productType  String // "Booster Box", "Booster Pack", "Bundle", "Proving Grounds", …
  setCode      String? // OGN/SFD/UNL/OGS/VEN if detectable
  retailer     String
  retailerName String
  priceCents   Int
  url          String
  imageUrl     String?
  inStock      Boolean  @default(true)
  // Market: "AU" (Australian stores, AUD) or "NZ" (NZ stores, NZD).
  country      String   @default("AU")
  lastSeen     DateTime @default(now())

  @@index([groupKey])
  @@index([retailer])
  @@index([country])
}

// A test-mode marketplace order placed through the CSFloat-style storefront
// (cart → checkout → simulated payment). No real payment gateway yet; buyer
// details + item snapshot are stored so the flow can be exercised end to end.
model MarketplaceOrder {
  id              String   @id @default(cuid())
  buyerName       String
  buyerEmail      String
  shippingAddress String
  // [{ listingId, cardName, collectorNumber, condition, isFoil, qty, priceCents, currency, sellerName }]
  items           Json
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  currency        String   @default("AUD")
  status          String   @default("TEST_PAID") // test mode: PENDING | TEST_PAID
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// A completed trade. Either a buyer hit a listing (kind LISTING) or a seller
// filled a buy order (kind BUYORDER).
model Order {
  id           String   @id @default(cuid())
  kind         String   @default("LISTING") // LISTING | BUYORDER
  listingId    String?
  buyOrderId   String?
  buyerId      String
  sellerId     String
  quantity     Int      @default(1)
  totalCents   Int
  createdAt    DateTime @default(now())

  listing      Listing?  @relation(fields: [listingId], references: [id])
  buyOrder     BuyOrder? @relation(fields: [buyOrderId], references: [id])
  buyer        User      @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller       User      @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
}

// Footer newsletter capture — "weekly Index summary in your inbox". The weekly
// send itself is a workflow; this table is the direct-audience list.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  market    String   @default("AU")
  createdAt DateTime @default(now())
}
