# DexCompare environment configuration. Copy to .env and fill in what you use.
# Everything is optional unless marked required — features no-op gracefully when
# their keys are missing. Never commit your real .env.

# ── Database (required) ────────────────────────────────────────────────────────
# Postgres connection string (Neon pooled URL in production).
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/dexcompare"

# Secret used to sign the marketplace-admin session cookies.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# ── Cron protection ────────────────────────────────────────────────────────────
# When set, /api/cron/* require "Authorization: Bearer <CRON_SECRET>" (Vercel Cron
# sends it automatically once the env var exists).
CRON_SECRET=""

# ── eBay (Browse API price source + Partner Network revenue) ──────────────────
# From developer.ebay.com → your app's production keyset.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# eBay Partner Network campaign id (also baked into src/lib/affiliate.ts).
EBAY_AFFILIATE_CAMPAIGN="5339155912"
# Quota controls. The importer reads the LIVE remaining call count (and limit)
# from eBay's Analytics API each run, spends down to the reserve, and stops —
# so a raised eBay quota is used automatically with no change here.
#   EBAY_QUOTA_RESERVE  — calls always left unspent (shared-quota headroom for
#                         RiftCompare, which uses the same eBay app). Default 600.
#   EBAY_MAX_CALLS      — fallback budget when the live count can't be read.
#   EBAY_MARKET_WEIGHTS — how the run budget splits across marketplaces.
#   EBAY_STALE_HOURS    — a card searched more recently than this is "fresh" and
#                         deprioritised in the rotation. Default 72.
#   EBAY_ROW_TTL_DAYS   — eBay price rows unconfirmed this long are pruned. Default 21.
#   EBAY_HOT_SHARE      — share of each market's budget always spent on the
#                         top-demand cards. Default 0.25.
EBAY_QUOTA_RESERVE="600"
EBAY_MAX_CALLS="2200"
EBAY_MARKET_WEIGHTS="AU:40,US:35,GB:25"
# Marketplace account-deletion webhook (eBay compliance requirement). Endpoint
# lives at /api/ebay/marketplace-deletion; enter the same token in the eBay portal.
EBAY_VERIFICATION_TOKEN=""
EBAY_DELETION_ENDPOINT="https://dexcompare.app/api/ebay/marketplace-deletion"

# ── Email (wishlist price-drop alerts, via Resend) ─────────────────────────────
# resend.com → API key. The sender domain must be verified in Resend or delivery
# is restricted to the account owner.
RESEND_API_KEY=""
EMAIL_FROM="DexCompare <noreply@dexcompare.app>"

# ── HilltopAds (primary ad network) ────────────────────────────────────────────
# MultiTag zone loader URL (baked into src/lib/ads.ts; set "" here to disable ads).
NEXT_PUBLIC_HILLTOPADS_SRC=""

# ── Affiliate networks ─────────────────────────────────────────────────────────
AMAZON_ASSOCIATE_TAG="dexcompare-20"
# TCGplayer affiliate (Impact) deep-link base — set once the application is approved.
TCGPLAYER_IMPACT_LINK=""
# Auto-affiliate network for the long tail of Shopify stores (Sovrn Commerce).
# Empty = links pass through untouched.
AFFILIATE_NETWORK="sovrn"
AFFILIATE_NETWORK_ID=""

# ── AI (trade-roast flavour text; rules-based fallback when unset) ─────────────
ANTHROPIC_API_KEY=""
# Or Google Gemini's free tier (aistudio.google.com):
GEMINI_API_KEY=""

# ── SEO ────────────────────────────────────────────────────────────────────────
# Google Search Console "HTML tag" verification token (default baked into layout).
GOOGLE_SITE_VERIFICATION=""

# ── Import tuning ──────────────────────────────────────────────────────────────
# Wall-clock budget for the daily import in minutes (default 70).
IMPORT_BUDGET_MIN=""
# Cards (by demand) whose cheapest listing is re-confirmed against the live
# product page each run (default 1500).
CONFIRM_CAP=""
